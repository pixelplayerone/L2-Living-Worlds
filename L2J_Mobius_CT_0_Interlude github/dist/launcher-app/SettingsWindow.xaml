<Window x:Class="LivingWorld.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="Gold" Color="#C9A15A"/>
    <SolidColorBrush x:Key="Ink"  Color="#EDE3D2"/>
    <SolidColorBrush x:Key="InkDim" Color="#9C9385"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1E140E08"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#3AC9A15A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#1E140E08"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#3AC9A15A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#2A1D140B"/>
      <Setter Property="BorderBrush" Value="#3AC9A15A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="10" Background="#0D0A07" BorderBrush="#55C9A15A" BorderThickness="1">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="#40000000">
        <TextBlock Text="SETTINGS" Margin="18,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource Gold}" FontFamily="Georgia" FontSize="14"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,4,20,4">
        <StackPanel>
          <TextBlock Style="{StaticResource Section}" Text="Java"/>
          <TextBlock Style="{StaticResource Field}" Text="Java home (folder with bin\java.exe). Blank = auto-detect / bundled."/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="JavaHomeBox" Grid.Column="0"/>
            <Button x:Name="JavaBrowse" Grid.Column="2" Style="{StaticResource Btn}" Content="Browse..."/>
          </Grid>

          <TextBlock Style="{StaticResource Section}" Text="Database"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Field}" Text="Host"/>
              <TextBox x:Name="HostBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Field}" Text="Port"/>
              <TextBox x:Name="PortBox"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Field}" Text="User"/>
              <TextBox x:Name="UserBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Field}" Text="Password"/>
              <PasswordBox x:Name="PasswordBox"/>
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Field}" Text="Database name"/>
          <TextBox x:Name="DatabaseBox"/>
          <TextBlock Style="{StaticResource Field}" Text="MySQL/MariaDB bin folder (absolute, or relative to dist\ for a bundled pack)"/>
          <TextBox x:Name="MysqlBinBox"/>
          <TextBlock Style="{StaticResource Field}" Text="DataDir (set ONLY for a bundled/portable MariaDB; blank for external MySQL/XAMPP)"/>
          <TextBox x:Name="DataDirBox"/>
          <CheckBox x:Name="AutoStartMysqlCheck" Content="Auto-start the database engine if the port is closed"/>

          <TextBlock Style="{StaticResource Section}" Text="Servers"/>
          <CheckBox x:Name="StartLoginCheck" Content="Start login server"/>
          <CheckBox x:Name="StartGameCheck" Content="Start game server"/>
          <CheckBox x:Name="StartBrainCheck" Content="Start the FPC brain with the server (only if already configured)"/>
          <TextBlock Style="{StaticResource Field}" Text="The brain adds in-character bot chat. Set it up once (installs Python, then pick Ollama or DeepSeek); it opens in its own window. Run it again any time to reconfigure."/>
          <Button x:Name="BrainSetupButton" Style="{StaticResource Btn}" Content="Set up / configure brain..." HorizontalAlignment="Left" Margin="0,4,0,0"/>

          <TextBlock Style="{StaticResource Section}" Text="Game client"/>
          <TextBlock Style="{StaticResource Field}" Text="Client exe to launch after the server is up (e.g. C:\L2\system\L2.exe). Blank = do not launch."/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ClientExeBox" Grid.Column="0"/>
            <Button x:Name="ClientBrowse" Grid.Column="2" Style="{StaticResource Btn}" Content="Browse..."/>
          </Grid>
          <CheckBox x:Name="LaunchClientCheck" Content="Launch the game client too (one-click server + game)"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#B3050403" BorderBrush="#33C9A15A" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
          <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
          <Button x:Name="SaveButton" Style="{StaticResource Btn}" Content="Save"
                  Background="#33582C" BorderBrush="#4E7B3C"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
